# =============================================================================
# Supabase Configuration
# =============================================================================
# Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Modern API Keys (recommended by @supabase/server)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Legacy Supabase Keys (supported for backward compatibility)
# SUPABASE_ANON_KEY=your-legacy-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key-here

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
